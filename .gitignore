.venv/
__pycache__/
*.pyc
.pytest_cache/

# Secrets — never commit
.env

# Working data. The published dataset is exported deliberately, not by accident:
# raw transcripts contain full model replies and are released with the paper.
data/*.duckdb
data/*.duckdb.tmp
data/*.duckdb.wal
data/raw/
data/raw_dryrun/
data/*.jsonl
data/.adjudications*

!data/.gitkeep

# The published dataset, released with the paper. Subjects were told at consent
# that the whole dataset would be published; these are the files that keeps.
!data/whoami.duckdb
!data/raw/
!data/run_manifest.jsonl

# Derived working files. The corpus dump is a view of the database, which is
# itself deliberately exported rather than committed.
analysis/_corpus/
data/raw_analysis/
